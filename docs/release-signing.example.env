# Example configuration for signed release builds of Gainalytics.
#
# This file is documentation, nothing loads it automatically. Copy the lines you need into your
# shell (or your CI secret store) and fill in your own values. Never commit real values or a
# keystore (*.keystore is ignored by Git). Keep your filled-in copy outside the repository.
#
#   cp docs/release-signing.example.env ~/.gainalytics-release.env   # outside the repo
#   $EDITOR ~/.gainalytics-release.env
#   set -a; . ~/.gainalytics-release.env; set +a
#   cd android && ./gradlew assembleRelease bundleRelease
#
# Debug builds need none of this; they use the standard React Native debug keystore
# (android/app/debug.keystore, password "android").

# Required. Password of the release keystore. android/app/build.gradle also uses it as the key
# password unless ANDROID_RELEASE_KEY_PASSWORD is set (see below).
ANDROID_RELEASE_PASSWORD=change-me

# Keystore location and key alias. android/app/build.gradle currently expects the keystore at
# android/app/your_key_name.keystore with the alias "your_key_alias". Create one with:
#   keytool -genkeypair -v -storetype PKCS12 -keystore android/app/your_key_name.keystore \
#     -alias your_key_alias -keyalg RSA -keysize 2048 -validity 10000
#
# Builds that support overriding these (see docs/release.md once present) read:
# ANDROID_RELEASE_STORE_FILE=/absolute/path/to/release.keystore
# ANDROID_RELEASE_KEY_ALIAS=your_key_alias
# ANDROID_RELEASE_KEY_PASSWORD=change-me

# AI features: there is deliberately no API key here. Users enter their own Anthropic API key in the
# app (Settings) or sign in with ChatGPT; credentials stay on the device. Do not bake a key into a
# build.
