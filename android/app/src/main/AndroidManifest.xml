<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!--
      No READ_MEDIA_VIDEO / READ_MEDIA_IMAGES on purpose (GH-421): videos are picked via
      ACTION_OPEN_DOCUMENT and kept alive with takePersistableUriPermission, which is the
      system picker the Play "Photo and Video Permissions" policy requires. A broad media
      permission would be a policy violation and buys the app nothing.
    -->
    <!-- Precise alarms (Android 12+) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Runtime notifications permission (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme">
      <activity
        android:name=".MainActivity"
        android:exported="true"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- GH-504: "Back to Gainalytics" link on the ChatGPT sign-in callback page -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="gainalytics" android:host="chatgpt-signin" />
        </intent-filter>
      </activity>
      <activity android:name="com.facebook.react.devsupport.DevSettingsActivity" />
      <service
        android:name=".VideoAnalysisForegroundService"
        android:exported="false"
        android:foregroundServiceType="dataSync" />
      <!-- GH-504: keeps the process unfrozen while "Sign in with ChatGPT" waits for the browser redirect -->
      <service
        android:name=".ChatGptSignInService"
        android:exported="false"
        android:foregroundServiceType="dataSync" />
    </application>

</manifest>
