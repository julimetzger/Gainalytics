<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- GH-502 PoC: the Health Connect client needs minSdk 26; the PoC module guards the call sites. -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

    <!-- GH-502 PoC: Health Connect permissions, debug builds only. -->
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application android:usesCleartextTraffic="true" tools:targetApi="28" tools:ignore="GoogleAppIndexingWarning">
        <!-- Android 13 and lower: Health Connect app opens this to show the privacy rationale. -->
        <activity
            android:name=".healthconnectpoc.HealthConnectRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!-- Android 14+: Health Connect is part of the system and uses this alias instead. -->
        <activity-alias
            android:name=".healthconnectpoc.ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".healthconnectpoc.HealthConnectRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
