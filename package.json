    "react": "19.2.3",
    "react-freeze": "^1.0.4",
    "react-native": "0.84.1",
    "react-native-calendars": "^1.1304.1",
    "react-native-charts-wrapper": "^0.7.0",
    "react-native-document-picker": "^9.1.1",
    "react-native-draggable-flatlist": "^4.0.1",
    "react-native-drawer-layout": "^4.2.12",
