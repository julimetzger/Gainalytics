    "@tsconfig/react-native": "^3.0.2",
    "@types/jest": "^29.5.8",
    "@types/react": "^19.1.1",
    "@types/react-test-renderer": "^19.3.0",
    "@types/redux-logger": "^3.0.9",
    "eslint": "^8.57.1",
