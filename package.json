    "react-native-svg": "^15.16.0",
    "react-native-timer-picker": "^2.7.1",
    "react-native-toast-message": "^2.5.2",
    "react-native-vector-icons": "^10.0.3",
    "react-native-worklets": "0.8.3",
    "react-redux": "^9.3.0",
